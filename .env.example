# Server Network Configuration
HOST=0.0.0.0
PORT=8008
DEBUG_MODE=True

# Polar Research Station Metadata
STATION_ID=ARCTIC-01
STATION_LOCATION=Polar Research Zone (78°13'N, 15°38'E)
